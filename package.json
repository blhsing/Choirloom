    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.1",
